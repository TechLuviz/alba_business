RewriteEngine On

# Serve CSS, JavaScript, images and storage files from public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(assets|images|storage|uploads)/(.*)$ public/$1/$2 [L]

# Laravel front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]